# Copy to .env next to docker-compose.yml.
#
# There are two modes:
#   A) Local development / tests  -> APP_ENV=development + SEED_DEMO=true (demo data and demo passwords).
#   B) A real restaurant          -> APP_ENV=production, SEED_DEMO=false and every secret changed.
#
# The values below are the DEVELOPMENT defaults. Before starting a real
# deployment change APP_ENV, SEED_DEMO and every secret: production refuses demo
# passwords, a short JWT_SECRET and CORS "*".
APP_ENV=development
SEED_DEMO=true
DB_NAME=restaurant_db
JWT_SECRET=replace-with-a-unique-value-of-at-least-32-characters
CORS_ORIGINS=http://localhost:8081

# Staff passwords. Used on the FIRST boot only, while the database is empty.
# In production they are required and cannot be a demo default, otherwise the
# backend refuses to start. docker compose also checks they are not empty.
SEED_ADMIN_PASSWORD=admin123
SEED_CAJERO_PASSWORD=cajero123
SEED_MOZO_PASSWORD=mozo123
SEED_COCINA_PASSWORD=cocina123

# Demo logins when APP_ENV is development:
# admin@resto.com / admin123
# cajero@resto.com / cajero123
# mozo@resto.com / mozo123
# cocina@resto.com / cocina123
#
# For a real restaurant change the passwords right away: after the first boot
# you can update them from Equipo (users) inside the panel.
