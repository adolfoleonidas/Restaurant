# Copy to .env next to docker-compose.yml for local tests.
# Do not use these demo values on a real server.
# APP_ENV=production refuses demo passwords, a short JWT_SECRET, and CORS *.
APP_ENV=development
SEED_DEMO=true
DB_NAME=restaurant_db
JWT_SECRET=replace-with-a-unique-value-of-at-least-32-characters
CORS_ORIGINS=http://localhost:8081
# Demo logins when APP_ENV is development:
# admin@resto.com / admin123
# cajero@resto.com / cajero123
# mozo@resto.com / mozo123
# cocina@resto.com / cocina123
