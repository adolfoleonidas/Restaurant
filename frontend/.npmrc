; This project ships a peer range npm refuses in a clean install:
; react-day-picker@8 declares date-fns ^2.28.0 || ^3.0.0 while the app is on
; date-fns@4.1.0. The tree resolves and runs, so the mismatch is tolerated
; deliberately instead of silently changing date behaviour to satisfy the peer
; range. Aligning those two versions is a separate, verifiable change.
legacy-peer-deps=true

; The frontend lockfile is the one CI installs from.
package-lock=true
